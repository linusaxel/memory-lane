# Build context hygiene: venv/ alone is ~300MB
venv/
venv.broken-py314/
.venv/
.git/
.github/
.idea/
.vscode/
.claude/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Not needed to serve the API
docs/
tests/
mobile/
loop/
transcripts/
*.log
*.md
# Local uploads. MEDIA_DIR is a volume in the container.
media/

# Never ship secrets
.env
