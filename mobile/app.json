{
  "expo": {
    "name": "Memory Lane",
    "slug": "memory-lane",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png"
      },
      "bundleIdentifier": "com.PLACEHOLDER.memorylane",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.PLACEHOLDER.memorylane",
      "adaptiveIcon": {
        "backgroundColor": "#A8350F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "INTERNET"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "PLACEHOLDER"
        }
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "memorylane",
    "primaryColor": "#1C1917",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Memory Lane uses your location to show travel memories recorded near you.",
          "locationAlwaysAndWhenInUsePermission": "Memory Lane can notify you when you're near a memory you haven't unlocked yet, even when the app is in the background. This is off until you turn it on in Settings.",
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "motionUsagePermission": "Memory Lane counts your steps for your journal. Only the steps since you last opened the app are sent, never your step history."
        }
      ],
      "expo-secure-store",
      [
        "expo-sensors",
        {
          "motionPermission": "Memory Lane counts your steps for your journal. Only the steps since you last opened the app are sent, never your step history."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Memory Lane records your voice when you say a memory out loud at a place.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Memory Lane attaches photos you choose to memories you file at a place.",
          "cameraPermission": "Memory Lane uses the camera for photos you attach to a memory you file here."
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 200,
          "backgroundColor": "#F7F4EE",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#161412"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/withoutBackgroundFetch",
      [
        "expo-build-properties",
        {
          "ios": { "deploymentTarget": "17.0" }
        }
      ]
    ]
  }
}
