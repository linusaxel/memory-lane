# Baked into the bundle when the dev server starts - not read at runtime. Change
# one and restart Metro, or the old value is still in the app.

# Where the API is. localhost for the simulator; a LAN IP only for a real phone,
# and then only while you stay on that network.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Google sign-in. One client id per platform, from the Google Cloud console.
# Leave them blank and the Google button hides itself rather than opening a
# browser that cannot succeed. Neither sign-in works in Expo Go: Apple needs the
# entitlement and Google needs the app's own URL scheme, so both want a
# development build.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Pin the app's position instead of asking GPS, so `xcrun simctl location booted
# set` stops being a step you repeat after every boot - and so a physical device
# can be told where it is, which simctl cannot do. Read only under __DEV__.
#
# Pair it with `python -m pipeline.seed_dev`, which plants memories you can
# actually reach at exactly this coordinate. Leave it blank to use real GPS.
EXPO_PUBLIC_DEV_LOCATION=40.7484,-73.9857

# Open one memory's sheet on launch, so the sheet can be screenshotted without
# a finger - there is no tap automation for the Simulator here. Read only under
# __DEV__. `python -m pipeline.seed_dev` prints the id of every state the sheet
# can render; leave it blank for the normal map.
EXPO_PUBLIC_DEV_OPEN_MEMORY=

# Land on one screen instead of the map: walk, journal, or submit. The
# submit sheet is three taps in and there is no tap automation, so this is the
# only way to look at it. Read only under __DEV__.
EXPO_PUBLIC_DEV_OPEN_SCREEN=
