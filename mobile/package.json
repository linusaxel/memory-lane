{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/ui": "~57.0.21",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "expo": "~57.0.24",
    "expo-apple-authentication": "~57.0.2",
    "expo-audio": "~57.0.5",
    "expo-auth-session": "~57.0.12",
    "expo-build-properties": "~57.0.22",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.19",
    "expo-location": "~57.0.19",
    "expo-notifications": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-sensors": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.19",
    "expo-web-browser": "~57.0.3",
    "react": "^19.3.0",
    "react-native": "0.86.3",
    "react-native-maps": "^1.29.8",
    "react-native-purchases": "^10.10.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "^5.10.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "patch-package": "^8.0.1",
    "prettier": "3.9.9",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write App.tsx index.ts src",
    "format:check": "prettier --check App.tsx index.ts src",
    "postinstall": "patch-package"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "private": true
}
