# Database (optional - defaults to local Docker)
DATABASE_URL=postgresql://memorylane:memorylane@localhost:5432/memorylane

# Redis (optional - defaults to local Docker)
REDIS_URL=redis://localhost:6379/0

# API Keys (required)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxx

# LLM Models (optional)
EXTRACTION_MODEL=claude-sonnet-5
CLASSIFIER_MODEL=claude-haiku-4-5

# API (optional). Comma-separated origins; defaults to "*".
# The only knob that locks down a public API - set it before exposing one.
# How close you must stand to read a memory. 150m, not 50m: urban GPS drifts.
UNLOCK_RADIUS_METERS=150
# Where uploaded photos and recordings are written. Relative to the working
# directory; docker-compose points it at a named volume.
MEDIA_DIR=media
# How many different people have to report a submission before it stops being
# served. The row survives - `hidden` is a flag, not a delete.
REPORT_THRESHOLD=3
# The embeddable map (Phase 2). Set to 0 on a public host: it ships
# OpenStreetMap's public tiles, whose usage policy this would violate.
ENABLE_EMBED=1

# Sign-in. Google and Apple only; no passwords anywhere.
#
# Both are comma-separated audience whitelists, and both are REQUIRED before the
# matching endpoint will do anything - an empty list would mean "accept a token
# minted for any app", so /v1/auth/* answers 503 rather than verifying against
# nothing. Leave them blank until there are real ids.
#
# Google issues one client id per platform and the token is minted for whichever
# one asked, so list every platform the app ships on.
GOOGLE_CLIENT_IDS=
# The iOS bundle id, plus the Services ID if there is ever a web flow.
APPLE_CLIENT_IDS=

CORS_ORIGINS=*

# Chunking (optional)
CHUNK_MINUTES=4
CHUNK_OVERLAP_SECONDS=30

